# =============================================================================
# EphemeralShield — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values.
# Run: scripts/generate-secrets.ps1 (Windows) or scripts/generate-secrets.sh
#
# SECURITY: Never commit .env to Git. It contains secrets.
# This .env.example contains ONLY placeholders and documentation.
# =============================================================================

# ---------------------------------------------------------------------------
# Control-Plane Database (broker-db)
# ---------------------------------------------------------------------------
# This is where EphemeralShield stores its own metadata: leases, requests,
# audit trail, policies, etc. It is NOT the target database.
#
# Format: postgresql+psycopg://user:password@host:port/database
# We use psycopg (v3) as the driver — it supports async natively.
# Port 5432 is used inside Docker network; 5433 is the host-mapped port.
# ---------------------------------------------------------------------------
BROKER_DB_URL=postgresql+psycopg://ephemeralshield:CHANGE_ME_BROKER_PASSWORD@broker-db:5432/ephemeralshield

# These are used by the broker-db Docker container on first start only.
# They create the initial database and superuser inside the container.
BROKER_DB_USER=ephemeralshield
BROKER_DB_PASSWORD=CHANGE_ME_BROKER_PASSWORD
BROKER_DB_NAME=ephemeralshield

# ---------------------------------------------------------------------------
# Test Target Database (test-target-db)
# ---------------------------------------------------------------------------
# A disposable PostgreSQL instance that simulates a real production database.
# Seeded with synthetic customers/orders/payments data.
# NEVER point this at your real target-db — destructive tests run here.
# ---------------------------------------------------------------------------
TEST_TARGET_DB_HOST=test-target-db
TEST_TARGET_DB_PORT=5432
TEST_TARGET_DB_USER=target_admin
TEST_TARGET_DB_PASSWORD=CHANGE_ME_TARGET_PASSWORD
TEST_TARGET_DB_NAME=target_app

# ---------------------------------------------------------------------------
# Redis (Optional Acceleration)
# ---------------------------------------------------------------------------
# Redis is used for expiry hints and caching, but PostgreSQL remains the
# authoritative source. The system works correctly if Redis is unavailable.
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Lease Defaults
# ---------------------------------------------------------------------------
# DEFAULT: How long a credential lasts if the user doesn't specify a TTL.
# MAX: Absolute ceiling — no policy can grant more than this.
# Values are in seconds. 1800s = 30min, 7200s = 120min.
# ---------------------------------------------------------------------------
LEASE_DEFAULT_TTL_SECONDS=1800
LEASE_MAX_TTL_SECONDS=7200

# ---------------------------------------------------------------------------
# Worker Configuration
# ---------------------------------------------------------------------------
# SCAN_INTERVAL: How often the background worker checks for expired leases.
#   1 second is aggressive but necessary for the p99 < 5s revocation target.
# ---------------------------------------------------------------------------
WORKER_SCAN_INTERVAL_SECONDS=1.0

# ---------------------------------------------------------------------------
# Audit Chain
# ---------------------------------------------------------------------------
# Path to the Ed25519 private key used to sign audit checkpoints.
# Generate with: scripts/generate-secrets.ps1
# The corresponding public key is stored separately for verification.
# ---------------------------------------------------------------------------
AUDIT_SIGNING_KEY_PATH=./secrets/audit-signing.key

# ---------------------------------------------------------------------------
# Application Settings
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
